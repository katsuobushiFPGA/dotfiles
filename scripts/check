#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_DIR"

git diff --check
bash -n bootstrap.sh bin/claude-notify dot_claude/hooks/session-lib.sh dot_claude/hooks/executable_*.sh
jq empty dot_claude/settings.json dot_agents/dot_skill-lock.json
# --force で「target が手動変更されている」対話プロンプトを抑止（apm.lock 等が
# apm 実行でドリフトしても非対話で通す）。--dry-run なので実際の書き込みはせず、
# テンプレート描画エラーの検出という本来の目的は維持される。
chezmoi apply --dry-run --force --source "$REPO_DIR"
shellcheck bootstrap.sh bin/claude-notify dot_claude/hooks/session-lib.sh dot_claude/hooks/executable_*.sh
