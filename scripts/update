#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_DIR"

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

find_apm_bin() {
  if [[ -x "$HOME/.local/bin/apm" ]]; then
    echo "$HOME/.local/bin/apm"
  elif command_exists apm; then
    command -v apm
  fi
}

if [[ "${DOTFILES_UPDATE_REEXECED:-}" != "1" ]]; then
  BEFORE_HEAD="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true)"
  git -C "$REPO_DIR" pull --ff-only
  AFTER_HEAD="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true)"

  if [[ -n "$BEFORE_HEAD" && "$BEFORE_HEAD" != "$AFTER_HEAD" ]]; then
    export DOTFILES_UPDATE_REEXECED=1
    exec bash "$REPO_DIR/scripts/update"
  fi
fi

# apm.lock は後段の `apm install -g` で毎回再生成され target がドリフトするため、
# 通常の `chezmoi apply` だと「手動変更を上書きするか」の対話プロンプトが出て
# 非対話実行（CI・スクリプト経由）で止まる。どのみち再生成するので apm.lock だけ
# 先に --force で source 状態へ揃え、プロンプトを回避する。--force はこのパスのみに
# 効き、settings.json 等の他のローカル変更は後続の通常 apply で対話確認させる（破壊しない）。
# target 側の存在も確認する: ~/.apm/ 未作成のマシンでは target 指定 apply が親ディレクトリを
# 掘れず失敗し set -e で全体停止するため。target が無ければ解消すべきドリフトも無いので、
# この特別扱いをスキップして後続の通常 apply（親ごと新規作成、プロンプト無し）に任せる。
[[ -f "$REPO_DIR/dot_apm/apm.lock.yaml" && -f "$HOME/.apm/apm.lock.yaml" ]] && \
  chezmoi apply --force --source "$REPO_DIR" "$HOME/.apm/apm.lock.yaml"

chezmoi apply --source "$REPO_DIR"
mise upgrade

if command_exists npx && [[ -f "$HOME/.agents/.skill-lock.json" ]]; then
  (cd "$HOME" && npx -y skills experimental_install)
fi

APM_BIN="$(find_apm_bin || true)"
if [[ -f "$HOME/.apm/apm.yml" && -n "$APM_BIN" ]]; then
  (cd "$HOME" && "$APM_BIN" install -g)
  if [[ -f "$HOME/.apm/apm.lock.yaml" ]]; then
    # apm バージョン・実行環境に依存して変動するフィールドを除去してから dotfiles に同期
    sed -i.bak \
      -e '/^generated_at:/d' \
      -e '/^apm_version:/d' \
      "$HOME/.apm/apm.lock.yaml"
    rm -f "$HOME/.apm/apm.lock.yaml.bak"
    # dot_apm/ は chezmoi apply 済みのため必ず存在する
    cp "$HOME/.apm/apm.lock.yaml" "$REPO_DIR/dot_apm/apm.lock.yaml"
  fi
fi

if command_exists uv; then
  # serena が未インストールの場合 uv は exit 1 になり得る（uv のバージョン依存）。
  # set -Eeuo pipefail 配下で update を止めないよう || true で握る。初回 install は bootstrap.sh が担当。
  uv tool upgrade serena-agent --prerelease=allow || true
fi

if command_exists npx; then
  npx playwright install chromium
fi
